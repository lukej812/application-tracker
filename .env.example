# Server only. Used by app/api/classify for the AI pass.
ANTHROPIC_API_KEY=

# Optional. Model for the AI pass. Defaults to claude-opus-5-5.
CALLBACK_MODEL=

# Browser and server. OAuth 2.0 Web client ID from Google Cloud (see README, "Google setup").
# The server uses it to check that sign-in tokens were issued to this app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. AI requests per user per hour, and per day for the whole app.
CALLBACK_USER_HOURLY_LIMIT=
CALLBACK_DAILY_LIMIT=

# Production: shared rate-limit counts across server instances (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
